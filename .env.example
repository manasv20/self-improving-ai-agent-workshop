# LLM — Qwen3.5-4B via LM Studio (OpenAI-compatible)
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
PARCELCO_MODEL=qwen3.5-4b
PARCELCO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Langfuse — optional self-hosted tracing (see docs/LANGFUSE_DOCKER.md)
# Leave empty unless you have created a local project and API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# App
FLASK_SECRET_KEY=workshop-dev-secret
PARCELCO_MAX_HEAL=2
PARCELCO_MAX_OUTER_ROUNDS=5
PARCELCO_MIN_DELTA=0.05
PARCELCO_PART_B_TOLERANCE=0.05
# Suite size: full = 700 improve + 300 holdout;
# demo = core 28+19 for a faster live click-through
PARCELCO_SUITE=full
