# LLM — Qwen3.5-4B via LM Studio (see docs/SETUP.md)
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
PARCELCO_MODEL=qwen3.5-4b
# Current LM Studio: disable thinking to preserve the reply token budget.
# Leave empty for a server that does not support reasoning_effort.
PARCELCO_REASONING_EFFORT=none
PARCELCO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# LangFuse — optional self-hosted tracing (see docs/LANGFUSE_DOCKER.md)
# Start: ./scripts/start-langfuse.sh
# Leave empty until you create a local project and API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Harness knobs
PARCELCO_MAX_HEAL=2
PARCELCO_MAX_OUTER_ROUNDS=5
PARCELCO_MIN_DELTA=0.05
PARCELCO_PART_B_TOLERANCE=0.05

# Suite size: full = 700 improve + 300 holdout;
# demo = core 28 learn + 19 holdout (47) for a faster live click-through
PARCELCO_SUITE=demo
