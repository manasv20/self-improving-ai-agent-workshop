# LLM — local Qwen via LM Studio (OpenAI-compatible)
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
PARCELCO_MODEL=qwen3.8_4b_distilled_gguf
PARCELCO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# LangFuse — self-hosted Docker (see docs/LANGFUSE_DOCKER.md)
# Start: ./scripts/start-langfuse.sh
LANGFUSE_PUBLIC_KEY=pk-lf-workshop-aa8504fbeda3a221cb5d6a06dd9bd83c
LANGFUSE_SECRET_KEY=sk-lf-workshop-4bfad518fa4844a0a79e1d3cd0585409
LANGFUSE_HOST=http://localhost:3000

# App
FLASK_SECRET_KEY=workshop-dev-secret
PARCELCO_MAX_HEAL=2
PARCELCO_MAX_OUTER_ROUNDS=5
PARCELCO_MIN_DELTA=0.05
PARCELCO_PART_B_TOLERANCE=0.05
# Suite size: full = 100 improve + 55 holdout (before→after proof);
# demo = core 20+15 for a faster live click-through
PARCELCO_SUITE=full
